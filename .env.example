# Copy this file to `.env` and fill in only the integrations you want to use.
# Zero API keys are required to run `--mode demo`, `--mode osm`, website enrichment,
# SQLite persistence, CSV exports, or the Web CRM Dashboard.

# --- Sender Identity ---
SENDER_NAME=Your Name
SENDER_COMPANY=Your Agency
SENDER_TITLE=Automation Consultant

# --- Storage & Logging ---
CRM_DB_PATH=output/crm.db
LOG_LEVEL=INFO

# --- Optional: Google Sheets Live Sync (gspread Service Account) ---
GOOGLE_SHEET_ID=your_google_sheet_id_here
GOOGLE_CREDENTIALS_PATH=credentials.json

# --- Optional: Google Places API (New) for `--mode google` ---
GOOGLE_PLACES_API_KEY=your_google_places_api_key_here

# --- Optional: Outbound SMTP (Defaults to Gmail SSL 465; supports any SMTP provider) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USE_TLS=false
GMAIL_ADDRESS=your_email@gmail.com
GMAIL_APP_PASSWORD=your_16_char_app_password
SMTP_USER=
SMTP_PASSWORD=

# --- Optional: Safety & Rate Limiting Guardrails ---
DAILY_SEND_LIMIT=25
SEND_DELAY_SECONDS=3.0
ENRICH_MAX_WORKERS=4
ENRICH_TIMEOUT_SECONDS=10
HTTP_USER_AGENT=LeadFinderOutreachCRM/2.0 (+https://github.com/example/lead-finder-outreach-crm)
